+/* Selected Impact: six headline results as quiet cardstock cards, in the
+   same surface language as the project cards (.project-tilt). */
+.impact-header { margin-bottom: 40px; }
+.impact-grid {
+  list-style: none;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 18px;
+}
+.impact-grid > li { display: flex; }
+.impact-card {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  padding: 24px 24px 22px;
+  text-align: left;
+  font: inherit;
