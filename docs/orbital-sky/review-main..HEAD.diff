+/*
+ * sky.js — scroll-driven orbital sunrise → morning → sunset background.
+ * Framework-agnostic. No dependencies. Copy verbatim.
+ *
+ *   import { createSky } from './sky.js';
+ *   const sky = createSky({ canvas, phases: SKY_PHASES });
