diff --git a/src/sky-panels.css b/src/sky-panels.css
new file mode 100644
index 0000000..8dadc08
--- /dev/null
+++ b/src/sky-panels.css
@@ -0,0 +1,92 @@
+/* Frosted reading panels over the orbital sky (owner decision 2026-10-10).
+   sky.css alone keeps the type legible while the sky is dark, but once the
+   sun is up it sits behind the right half of the text column, and copy that
+   was written for a dark page drops below AA. Each section's content column
+   gets a pane of frosted glass instead: drawn on ::before with a negative
+   inset, so layout, type and text colours stay exactly as they were. Its tint
+   follows the sky's brightness through --sky-scrim (set by sky.js: 0 at night,
+   up to 0.55 at the morning peak), so the pane stays a quiet smoked glass in
+   the dark and closes down at sunrise and sunset. The tint never reaches
+   opaque; the blur spreads the sun's core so no bright point sits under a
+   line of type. Values were tuned by measurement (qa/readability.py): every
+   text run on the sky clears AA against the 95th-percentile pixel behind it. */
+
+.sky-scrim > .container,
+.sky-scrim > .container-prose,
+.footer > .footer-inner,
+.trust-strip > .trust-strip-inner,
+.about-figure > figcaption,
+.hero-portrait > figcaption {
+  position: relative;
+  isolation: isolate;
+}
+.sky-scrim > .container::before,
+.sky-scrim > .container-prose::before,
+.footer > .footer-inner::before,
+.trust-strip > .trust-strip-inner::before,
+.about-figure > figcaption::before,
+.hero-portrait > figcaption::before {
+  content: "";
+  position: absolute;
+  inset: -40px 0;
+  z-index: -1;
+  pointer-events: none;
+  border-radius: 20px;
+  border: 1px solid var(--border);
+  background: rgba(12, 9, 7, min(0.92, calc(0.58 + var(--sky-scrim, 0) * 1.5)));
+  -webkit-backdrop-filter: blur(20px) saturate(1.05);
+          backdrop-filter: blur(20px) saturate(1.05);
+}
+/* the one-line credit strip under the hero: a slim pane, not a sheet. It sits
+   on the pre-dawn crest glow, where --sky-scrim is still ~0, so it starts darker. */
+.trust-strip > .trust-strip-inner::before {
+  inset: -12px 0; border-radius: 999px;
+  background: rgba(12, 9, 7, min(0.92, calc(0.68 + var(--sky-scrim, 0) * 1.5)));
+}
+/* the photo caption: shrink-wrap the (centred) line so its pane hugs it */
+.about-figure > figcaption { width: fit-content; margin-inline: auto; }
+.about-figure > figcaption::before,
+.hero-portrait > figcaption::before { inset: -6px -16px; border-radius: 999px; }
+@media (max-width: 720px) {
+  .sky-scrim > .container::before,
+  .sky-scrim > .container-prose::before,
+  .footer > .footer-inner::before { inset: -28px 12px; border-radius: 16px; }
+  .trust-strip > .trust-strip-inner::before { inset: -10px 12px; border-radius: 16px; }
+  /* Phones stack the portrait above the hero copy, which pushes the copy down
+     onto the glowing limb; on desktop it clears the limb and needs no pane. */
+  .hero-futurist .hero-text { position: relative; isolation: isolate; }
+  .hero-futurist .hero-text::before {
+    content: ""; position: absolute; inset: -24px -16px; z-index: -1; pointer-events: none;
+    border-radius: 16px; border: 1px solid var(--border);
+    background: rgba(12, 9, 7, min(0.92, calc(0.62 + var(--sky-scrim, 0) * 1.5)));
+    -webkit-backdrop-filter: blur(20px) saturate(1.05);
+            backdrop-filter: blur(20px) saturate(1.05);
+  }
+}
+@media print {
+  .sky-scrim > .container::before,
+  .sky-scrim > .container-prose::before,
+  .footer > .footer-inner::before,
+  .trust-strip > .trust-strip-inner::before,
+  .about-figure > figcaption::before,
+  .hero-portrait > figcaption::before { display: none; }
+}
+
+/* .sky-scrim isolates each section, which would trap the globe's fixed hover
+   card inside its section and let the next section paint over it. */
+#globe { z-index: 2; }
+
+/* Print: sky.css drops the sky and paints the page white, so the site's cream
+   type has to turn to ink, and the fixed chrome stays off the paper. */
+@media print {
+  .sky-page, .sky-page * {
+    color: #1b1612 !important;
+    -webkit-text-fill-color: currentColor !important;
+    text-shadow: none !important;
+    box-shadow: none !important;
+    -webkit-backdrop-filter: none !important;
+            backdrop-filter: none !important;
+  }
+  .masthead, .nav, .ask-ai, .scroll-top-btn, .skip-link,
+  #chatbase-bubble-window, #chatbase-message-bubbles { display: none !important; }
+}
diff --git a/src/sky.css b/src/sky.css
new file mode 100644
index 0000000..33001f0
--- /dev/null
+++ b/src/sky.css
@@ -0,0 +1,41 @@
+/* sky.css — styles for the orbital sky background. Copy verbatim. */
+
+/* 1. Page base: the poster is the first frame of the scene, shown instantly and kept as the no-WebGL fallback. */
+html, body { background-color: #07080d; }
+body {
+  background-image: url("/sky-poster.jpg");   /* adjust path to wherever the poster is served */
+  background-position: center bottom;
+  background-size: cover;
+  background-repeat: no-repeat;
+  background-attachment: fixed;
+}
+
+/* 2. The canvas: fixed, full-viewport, behind everything, fades in over the poster on first draw. */
+.sky-canvas {
+  position: fixed; inset: 0;
+  width: 100vw; height: 100%;
+  z-index: 0;                       /* all page content must sit above this: position: relative; z-index: 1 */
+  display: block;
+  pointer-events: none;
+  opacity: 0;
+  transition: opacity .9s ease;
+}
+.sky-canvas.on { opacity: 1; }
+
+/* 3. Readability: soft text shadow that strengthens in daylight (value set by sky.js). */
+body { text-shadow: 0 1px 22px var(--sky-glow, transparent); }
+
+/* 4. Readability: a soft dark pool behind each content section, stronger as the sky brightens.
+      Add class "sky-scrim" to each top-level section wrapper (presentational only). */
+.sky-scrim { position: relative; isolation: isolate; }
+.sky-scrim::before {
+  content: ""; position: absolute; inset: 40px -60px; z-index: -1; pointer-events: none;
+  background: radial-gradient(ellipse 42% 48% at 42% 50%,
+              rgba(10,7,5, calc(.32 + var(--sky-scrim, 0))),
+              rgba(10,7,5, 0) 100%);
+}
+/* The scrim overhangs its section by 60px each side; stop that from causing sideways scroll. */
+.sky-page { overflow-x: clip; }
+
+/* 5. Print: no sky. */
+@media print { .sky-canvas { display: none !important; } body { background: #fff !important; text-shadow: none !important; } .sky-scrim::before { display: none; } }
