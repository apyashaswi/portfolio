+   line, never a gap.) */
+.sky-scrim + .sky-scrim::before,
+#main + .footer.sky-scrim::before { top: 0; --fade-top: 0px; }
+.sky-scrim:has(+ .sky-scrim)::before,
+#main:has(+ .footer.sky-scrim) > .sky-scrim:last-child::before { bottom: 0; --fade-bottom: 0px; }
+/* the Seen-across strip sits 48px under the hero: its band covers that margin */
+.trust-strip.sky-scrim::before { top: -48px; }
+
+/* Deeper floor where the sun's core sits behind the column. The owner's .38
+   holds AA everywhere else; About (the sunrise) and the footer colophon
+   measured 3.1-4.4:1 on it, so their tint ramps from the shared edge up to .56
+   over 160px. Case-study pages are one long band whose closing links the
+   limb's bright line crosses (3.99:1 on .38): .50 throughout, and the footer
+   under them starts from that. Phones put the whole column over the sun: every
+   band starts at .50, About and the footer reach .66, job cards are .56. All
+   tuned with qa/readability.py to clear 4.5:1 against the 95th-percentile sky
+   pixel behind each line. */
+#about.sky-scrim::before, .footer.sky-scrim::before { --band-deep: calc(.56 + var(--sky-scrim,0)); }
